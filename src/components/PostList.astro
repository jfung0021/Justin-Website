---
import { withBase } from '../lib/base-path.mjs';
import {dateLabel,readingTime} from '../lib/notebook';
const {posts} = Astro.props;
---
<ol class="post-list">{posts.map((post: any) => <li><div><div class="metadata"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span>{post.data.category}<span>·</span>{post.data.type}<span>·</span>{readingTime(post.body)} min read</div><h2><a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a></h2><p>{post.data.description}</p>{post.data.tags.length>0&&<div class="tags">{post.data.tags.map((tag:string)=><span>#{tag}</span>)}</div>}{post.data.example && <span class="example-tag">Example post</span>}</div></li>)}</ol>
